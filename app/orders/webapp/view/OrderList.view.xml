<mvc:View
  controllerName="levelup.orders.controller.OrderList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Page id="orderListPage" title="{i18n>ordersTitle}">
    <subHeader>
      <Toolbar>
        <SearchField id="searchField" placeholder="{i18n>searchCustomer}" search=".onFilter"/>
      </Toolbar>
    </subHeader>
    <content>
      <!-- Aggregation binding met een standaardsortering: nieuwste order eerst -->
      <Table
        id="orderTable"
        items="{
          path: '/Orders',
          sorter: { path: 'orderDate', descending: true }
        }">
        <headerToolbar>
          <OverflowToolbar>
            <!-- Status uit de code list OrderStatus: geen vaste lijst in de code -->
            <ComboBox
              id="statusFilter"
              width="12rem"
              placeholder="{i18n>allStatuses}"
              showClearIcon="true"
              selectionChange=".onFilter"
              items="{ path: '/OrderStatus', sorter: { path: 'name' } }">
              <core:Item key="{code}" text="{name}"/>
            </ComboBox>
            <ToolbarSpacer/>
            <Button id="sortButton" icon="sap-icon://sort" tooltip="{i18n>sortDate}" press=".onSort"/>
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>colDate}"/></Column>
          <Column><Text text="{i18n>colCustomer}"/></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colStatus}"/></Column>
          <Column hAlign="End"><Text text="{i18n>colTotal}"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onOrderPress">
            <cells>
              <Text text="{orderDate}"/>
              <Text text="{customer/firstName} {customer/lastName}"/>
              <ObjectStatus
                text="{status/name}"
                state="{= %{status/criticality} === 3 ? 'Success' : %{status/criticality} === 2 ? 'Warning' : 'Error' }"/>
              <ObjectNumber number="{totalAmount}" unit="{currency_code}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
